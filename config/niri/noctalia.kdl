layout {

    focus-ring {
        active-color   "#076169"
        inactive-color "#f7fafa"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#076169"
        inactive-color "#f7fafa"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#076169"
        inactive-color "#2f7a82"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#07616980"
    }
}

recent-windows {
    highlight {
        active-color "#076169"
        urgent-color "#ba1a1a"
    }
}
